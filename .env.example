# 백엔드 주소 (계약 문서: {API_BASE}/api/v1)
VITE_API_BASE=http://localhost:8080
# 카카오맵 JavaScript 키 (공개용)
VITE_KAKAO_JS_KEY=
# 구글 로그인 OAuth 클라이언트 ID (웹 애플리케이션, 공개용). 비우면 구글 버튼 없이 메일 인증만 쓴다
VITE_GOOGLE_CLIENT_ID=
# 개발용 목 서버: true 면 실서버 없이 메모리 목 응답 사용(또는 주소에 ?mock=1). 로그인은 아무 6자리 코드. 화면 왼쪽 아래에 MOCK 배지
VITE_USE_MOCK=false
